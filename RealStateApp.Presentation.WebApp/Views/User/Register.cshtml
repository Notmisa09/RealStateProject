@using RealStateApp.Core.Application.ViewModels.User;
@using RealStateApp.Core.Application.Enum;
@model SaveUserViewModel;

@{
    ViewData["Title"] = "Register";
    var clientoption = RolesEnum.Client.ToString();
    var agentoption = RolesEnum.Agent.ToString();
}

<!-- Option 1: Bootstrap Bundle with Popper -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>

<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"></script>


@Html.ValidationSummary(false, "", new { @class = "text-danger" })
@if (Model.HasError)
{
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Error!',
            text: ' @Model.Error',
            showConfirmButton: true,
            timer: 5000
        });
    </script>
}

<div class="container-fluid">
    <div class="row">
        <div class="col-6 offset-3">
            <div class="card" style="background-color: white;">
                <div class="card-header  text-center bg-black">
                    <h4 class="text-light">Registro de nuevo usuario</h4>
                </div>
                <div class="card-body">

                    <form method="post" enctype="multipart/form-data" asp-controller="User" asp-action="Register">

                        <div class="mb-3">
                            <label asp-for="FormFile" class="form-label text-dark">Please select an profile image: </label>
                            <input asp-for="FormFile" class="form-control" style="background-color: white; color: black;" />
                            <span asp-validation-for="FormFile" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label font-weight-bold text-dark">Nombre: </label>
                                <input asp-for="FirstName" class="form-control" style="background-color: white; color: black;" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label font-weight-bold text-dark">Apellido: </label>
                                <input asp-for="LastName" class="form-control" style="background-color: white; color: black;" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label text-dark">Nombre de usuario: </label>
                            <input asp-for="UserName" class="form-control" style="background-color: white; color: black;" />
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="PhoneNumber" class="form-label text-dark">Telefono: </label>
                                <input asp-for="PhoneNumber" class="form-control" style="background-color: white; color: black;" />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label text-dark">Correo: </label>
                                <input asp-for="Email" class="form-control" style="background-color: white; color: black;" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-dark">Choose your role: </label>
                            <select class="form-control" name="Role">
                                <option value="@clientoption">Cliente</option>
                                <option value="@agentoption">Agente</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label text-dark">Contraseña: </label>
                            <input asp-for="Password" required class="form-control" style="background-color: white; color: black;" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label text-dark">Confirmar contraseña: </label>
                            <input asp-for="ConfirmPassword" required class="form-control" style="background-color: white; color: black;" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">Registrarse</button>
                        <a asp-controller="User" asp-action="Index" class="btn btn-warning">Volver atras</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        background-color: white;
        margin: auto;
        margin-top: 5%;
        padding: 20px;
        border-radius: 15px;
        box-shadow: 0 0 20px 0 rgba(0, 0, 0, 0.1);
    }

    .card-header {
        border-bottom: none;
        margin-bottom: 20px;
        padding-bottom: 0;
    }

    .form-label {
        font-weight: bold;
    }

    .form-control {
        border-radius: 10px;
        border: 1px solid #ced4da;
    }

    .btn-primary {
        border-radius: 10px;
        background-color: #6c63ff;
        border: none;
    }

    .btn-warning {
        border-radius: 10px;
        background-color: #ffb74d;
        border: none;
    }

    .text-danger {
        color: red;
    }
</style>
