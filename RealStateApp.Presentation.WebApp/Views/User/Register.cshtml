@using RealStateApp.Core.Application.ViewModels.User;
@using RealStateApp.Core.Application.Enum;
@model SaveUserViewModel;

@{
    ViewData["Title"] = "Register";
    var clientoption = RolesEnum.Client.ToString();
    var agentoption = RolesEnum.Agent.ToString();

}

<!-- Option 1: Bootstrap Bundle with Popper -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>

<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"></script>


@Html.ValidationSummary(false, "", new { @class = "text-danger" })
@if (Model.HasError)
{
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Error!',
            text: ' @Model.Error',
            showConfirmButton: true,
            timer: 5000
        });
    </script>
}

<div class="container-fluid">

    <div class="row">
        <div class="col-6 offset-3">
            <div class="card" style="background-color: white;">
                <div class="card-header text-light text-center bg-black">
                    <h4>Registro de nuevo usuario</h4>
                </div>
                <div class="card-body">

                    <form method="post" enctype="multipart/form-data" asp-controller="User" asp-action="Register">

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label text-dark">Nombre: </label>
                            <input asp-for="Name" class="form-control" style="background-color: white; color: black;" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LastName" class="form-label text-dark">Apellido: </label>
                            <input asp-for="LastName" class="form-control" style="background-color: white; color: black;" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label text-dark">Nombre de usuario: </label>
                            <input asp-for="UserName" class="form-control" style="background-color: white; color: black;" />
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label text-dark">Telefono: </label>
                            <input asp-for="PhoneNumber" class="form-control" style="background-color: white; color: black;" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label text-dark">Correo: </label>
                            <input asp-for="Email" class="form-control" style="background-color: white; color: black;" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-dark">Choose your role: </label>
                            <select class="form-control">
                                <option name="" value="@clientoption">Cliente</option>
                                <option name="" value="@agentoption">Agente</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label text-dark">Contraseña: </label>
                            <input asp-for="Password" required class="form-control" style="background-color: white; color: black;" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label text-dark">Confirmar contraseña: </label>
                            <input asp-for="ConfirmPassword" required class="form-control" style="background-color: white; color: black;" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">Registrarse</button>
                        <a asp-controller="User" asp-action="Index" class="btn btn-warning">Volver atras</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
