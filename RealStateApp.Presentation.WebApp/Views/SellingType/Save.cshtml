@using RealStateApp.Core.Application.ViewModels.SellingTypes;
@model SellingTypeAddViewModel;

@{
    ViewData["Title"] = "SellingType Save";
    bool EditMode = Model != null && Model.Id == 0;
}

<div class="container-fluid">
    <div class="col-4 offset-4">
        <div class="card">
            <div class="card-header">
                <strong>@(EditMode ? $"Edit your pruducer {Model.SellingTypeName}" : "Add a new User")</strong>

            </div>
            <div class="card-body">
                <form method="post" asp-controller="SellingType" asp-action=@(EditMode ? "Edit" : "Save")>
                    <div class="mb-3">
                        <label asp-for="SellingTypeName" class="form-label text-dark">Tipo de venta: </label>
                        <input asp-for="SellingTypeName" class="form-control" style="background-color: white; color: black;" />
                        <span asp-validation-for="SellingTypeName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label text-dark">Descripcion: </label>
                        <input asp-for="Description" class="form-control" style="background-color: white; color: black;" />
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <a asp-controller="SellingType" asp-action="Index" class="btn btn-warning">Go back</a>
                    <button type="submit" class="btn btn-primary">Save</button>

                </form>
            </div>
        </div>
    </div>
</div>

