@using RealStateApp.Core.Application.ViewModels.SellingTypes;
@model SellingTypeAddViewModel;

@{
    ViewData["Title"] = "Remove";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-4 offset-md-4 mt-4">
            <div class="card">
                <div class="card-header text-center">
                    Confirmar eliminación
                    <hr/>
                </div>
                <div class="card-body">
                    <h5 class="card-title">@Model.SellingTypeName</h5>
                    <p class="card-text">Descripción: @Model.Description</p>
                    <p class="card-text">¿Estás seguro que quieres eliminar este tipo de venta?</p>
                    <form method="post" asp-controller="SellingType" asp-action="RemoveTrue">
                        <input type="hidden" asp-for="Id" />
                        <div class="mb-3">
                            <a asp-controller="SellingType" asp-action="Index" class="btn btn-warning">Cancelar</a>
                            <button type="submit" name="confirmation" value="true" class="btn btn-danger">Sí, eliminar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

