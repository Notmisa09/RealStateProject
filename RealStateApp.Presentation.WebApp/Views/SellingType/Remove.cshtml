@using RealStateApp.Core.Application.ViewModels.SellingTypes;
@model SellingTypeAddViewModel;

@{
    ViewData["Title"] = "Remove";
}

<div class="container-fluid">
    <div class="col-4 offset-4">
        <div class="card">
            <form method="post" asp-controller="SellingType" asp-action="RemoveTrue">
                <div class="card-text">
                    @Model.SellingTypeName
                    @Model.Description
                </div>
                <button asp-route-id="@Model.Id" type="submit" class="btn btn-danger">Delete</button>
                <a asp-controller="SellingType" asp-action="Index" class="btn btn-warning">Go Back</a>
            </form>
        </div>
    </div>
</div>