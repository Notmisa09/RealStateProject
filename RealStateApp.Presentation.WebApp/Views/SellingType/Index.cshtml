@using RealStateApp.Core.Application.ViewModels.SellingTypes;
@model List<SellingTypeVeiwModel>;

<head>
    <link rel="stylesheet" href="~/css/table.css" />
    <script src="https://kit.fontawesome.com/7302c44b99.js" crossorigin="anonymous"></script>
</head>

<div class="container-fluid">
    <div class="col-6 offset-3">
        <a asp-controller="PropertyType" asp-action="Save" class="btn btn-primary">Register</a>
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var propertyType in Model)
                            {
                                <tr>
                                    <td>@propertyType.SellingTypeName</td>
                                    <td>@propertyType.Description</td>
                                    <td>
                                        <a asp-route-Id="@propertyType.Id" asp-controller="PropertyType" asp-action="Remove" class="btn btn-outline-danger"><i class="fa-solid fa-trash-can"></i></a>
                                        <a asp-route-Id="@propertyType.Id" asp-controller="PropertyType" asp-action="Edit" class="btn btn-outline-warning"><i class="fa-solid fa-pencil"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>