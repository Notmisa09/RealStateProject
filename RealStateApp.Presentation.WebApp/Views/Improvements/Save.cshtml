@using RealStateApp.Core.Application.ViewModels.Improvements;
@model ImprovementsAddViewModel;

@{
    ViewData["Title"] = "Register Property type";
    bool editMode = Model != null && Model.Id != 0;
}

<div class="container-fluid">
    <div class="col-4 offset-4">
        <div class="card">
            <div class="card-header">
                <strong>@(editMode ? $"Edit the improvement type {Model.ImprovementName}" : "Add a new improvement")</strong>
            </div>

            <div class="card-body">
                <form method="post" asp-controller="Improvements" asp-action=@(editMode ? "Edit" : "Save")>
                    <div class="mb-3">
                        <label asp-for="ImprovementName" class="form-label text-dark">Nombre del tipo de propiedad </label>
                        <input asp-for="ImprovementName" class="form-control" style="background-color: white; color: black;" />
                        <span asp-validation-for="ImprovementName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label text-dark">Descripcion</label>
                        <textarea asp-for="Description" class="form-control" style="background-color: white; color: black;"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <a asp-controller="Improvements" asp-action="Index" class="btn btn-warning">Go back</a>
                    <button type="submit" class="btn btn-primary">Save</button>
                </form>
            </div>

        </div>
    </div>
</div>

