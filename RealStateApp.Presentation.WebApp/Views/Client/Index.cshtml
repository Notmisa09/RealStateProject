@using RealStateApp.Core.Application.ViewModels.Properties
@using RealStateApp.Core.Application.ViewModels.PropertyType;
@model IList<PropertyViewModel>

@{
    ViewData["Title"] = "Home Page";
    <script src="https://kit.fontawesome.com/7302c44b99.js" crossorigin="anonymous"></script>
    <link href="./css/homesite.css" rel="stylesheet">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/5.1.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://kit.fontawesome.com/7302c44b99.js" crossorigin="anonymous">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    List<PropertyTypeViewModel> propType = ViewBag.PropertyType;
}
<section id="carousel-section">
    <div id="carouselExampleIndicators" class="carousel slide">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="https://content.elmueble.com/medio/2022/08/03/ly-villa-costa-blanca-3_1d6d2821_2000x1334.jpg" class="d-block w-100" alt="...">
                <div class="carousel-caption d-none d-md-block">
                    <h5>Aqui tenemos variedad</h5>
                    <p>Con casas de en sueño</p>
                </div>
            </div>

            <div class="carousel-item">
                <img src="/img/HomeCarousel/Casa de lujo 2.jpeg" class="d-block w-100" alt="...">
            </div>

            <div class="carousel-item">
                <img src="/img/HomeCarousel/Casa interior.jpeg" class="d-block w-100" alt="...">
            </div>

        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</section>

<h1 class="text-center dancing-script m-5">~Estas son nuestras propiedades~</h1>


<div class="container-fluid">
    <div class="card">
        <div class="card-body">
            <form asp-asp-controller="Home" asp-action="PropertyFilter" method="post">
                <div class="row">
                    <div class="col-md-2 mb-3">
                        <label class="form-label">Tipo de propiedad</label>
                        <select name="PropertyType" class="form-select">
                            @foreach (var item in propType)
                            {
                                <option value="#">Choose an option</option>
                                <option value="@item.Id">@item.PropertyTypeName</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2 mb-3">
                        <label class="form-label">Baños</label>
                        <select name="BathroomAmount" class="form-select" style="background-color: white; color: black;">
                            <option value="#">Choose an option</option>
                            @for (int i = 1; i <= 10; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2 mb-3">
                        <label class="form-label">Camas</label>
                        <select name="BedRoomAmount" class="form-select" style="background-color: white; color: black;">
                            <option value="#">Choose an option</option>
                            @for (int i = 1; i <= 10; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2 mb-3">
                        <label class="form-label text-dark">Precio Min</label>
                        <input name="MinValue" type="number" step="0.01" class="form-control" style="background-color: white; color: black;" lang="es-DO" />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label class="form-label text-dark">Precio Max</label>
                        <input name="MaxValue" type="number" step="0.01" class="form-control" style="background-color: white; color: black;" lang="es-DO" />
                    </div>

                    <div class="col-md-2 mt-4">
                        <button type="submit" class="btn btn-primary">Filtrar</button>
                    </div>
                </div>

                <div class="row">
                    <div class="col-4 offset-4 mt-4">
                        <div class="input-group">
                            <input name="PropertyCode" class="form-control" placeholder="Ingrese el código de propiedad" />
                            <button type="submit" class="btn btn-primary">Buscar</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<section id="Property-section" class="mt-5">
    <div class="container-fluid mt-5">
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="card ms-4 p-0 mt-3" style="width: 18rem;">
                    <div class="image-container position-relative">
                        <!-- Botón de la estrella -->
                        <a asp-route-Id="@item.Id" asp-controller="Client" asp-action="AddFav" class="btn btn-outline-dark position-absolute top-0 end-0 m-2">
                            <i class="fa-solid fa-star" style="color: #FFD43B;"></i>
                        </a>
                        <!-- Imagen de la propiedad -->
                        <img src="@item.FrontImage" class="card-img-top img-fluid" alt="Property Image">
                    </div>
                    <div class="card-body">
                        <p class="card-text fs-4">
                            <div class="mb-1">
                                Codigo: @item.PropertyCode
                            </div>

                            <div class="mb-1">
                                Precio: <span style="color:forestgreen; font-weight:bold">
                                    RD$ @item.Price
                                </span>
                            </div>

                            <div class="mb-1">
                                <i class="fa-solid fa-location-dot"></i> @item.Location
                            </div>
                            <div class="col-10 offset-1">
                                <div class="row g-0">
                                    <div class="col-md-4">
                                        <i class="fa-solid fa-bed"></i>: @item.BedroomsAmount
                                    </div>
                                    <div class="col-md-4">
                                        <i class="fa-solid fa-sink"></i>: @item.BathroomsAmount
                                    </div>
                                    <div class="col-md-4">
                                        <i class="fa-solid fa-ruler-combined"></i>: @item.Meters
                                    </div>
                                </div>
                            </div>
                        </p>
                        <a href="#" class="btn btn-dark">Details</a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>


<style>

    .dancing-script {
        font-family: "Dancing Script", cursive;
    }

    .image-container {
        height: 200px; /* Altura deseada para la imagen */
        overflow: hidden;
    }

        .image-container img {
            object-fit: cover;
            height: 100%; /* Hace que la imagen ocupe toda la altura del contenedor */
            width: 100%; /* Hace que la imagen ocupe todo el ancho del contenedor */
        }

    card {
        border-radius: 0px;
    }

    .form-label {
        font-weight: bold;
    }

    .form-control {
        border-radius: 10px;
        border: 1px solid #ced4da;
    }

    .btn-primary {
        border-radius: 10px;
        background-color: #6c63ff;
        border: none;
    }
</style>-