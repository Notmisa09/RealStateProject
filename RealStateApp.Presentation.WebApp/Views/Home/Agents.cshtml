@using RealStateApp.Core.Application.ViewModels.User;
@model List<UserViewModel>;

<!-- Portada de la Página -->
<!-- Scripts de Bootstrap y jQuery -->
<script src="https://cdn.jsdelivr.net/npm/popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"></script>

<style>
    .img-serie-size {
        height: auto; /* Para mantener la proporción original */
        max-width: 80%; /* Para que la imagen no se estire más allá de su tamaño original */
        transition: transform 0.3s ease-in-out;
    }

        .img-serie-size:hover {
            transform: scale(1.1);
        }
</style>

<div class="container-fluid">

    <h2 class="col-6 offset-4">~Estos son nuestros agentes ~</h2>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-3 mt-4 ">
                <!-- Modificado el tamaño de las columnas -->
                <div class="card">
                    <div class="card-body text-center">
                        <!-- Añadido text-center para centrar el contenido -->
                        @if (item.ImageURL != null)
                        {
                            <a asp-controller="Home" asp-action="AgentRealEstates"
                               asp-route-id="@item.Id" title="VER INFORMACION DEL AGENTE">
                                <img src="@item.ImageURL" class="card-img-top img-serie-size rounded-circle" />
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Home" asp-action="AgentRealEstates" asp-route-id="@item.Id" title="VER INFORMACION DEL AGENTE">
                                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQTnB8SJzsxM_KKbFNf-er2X-WiEdHMHXuz6w&usqp=CAU"
                                     class="card-img-top img-serie-size rounded-circle" />
                            </a>
                        }
                        <h3 class="mt-3 font-weight-bold">@item.FirstName @item.LastName</h3> <!-- Añadido margen superior -->
                    </div>
                </div>
            </div>
        }
    </div>
</div>
