@using RealStateApp.Core.Application.ViewModels.User;
@model List<UserViewModel>;


<script src="https://cdn.jsdelivr.net/npm/popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"></script>
<link rel="stylesheet" .ref="https://stackpath.bootstrapcdn.com/bootstrap/5.1.3/css/bootstrap.min.css">
<link rel="stylesheet" href="https://kit.fontawesome.com/7302c44b99.js" crossorigin="anonymous">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400..700&display=swap" rel="stylesheet">



<div class="container-fluid">

    <h1 class="text-center m-3 dancing-script">~Estos son nuestros agentes~</h1>


    <form method="post" asp-controller="Home" asp-action="AgentFilter" class="card card-sm mb-4 col-4 offset-4">
        <div class="card-body row no-gutters align-items-center">
            <div class="col">
                <input class="form-control form-control-lg form-control-borderless"
                       type="search" name="AgentName" placeholder="Type in the name of the agent">
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" type="submit"><i class="fa-sharp fa-solid fa-magnifying-glass"></i></button>
                <a asp-controller="Home" asp-action="Agents" class="btn btn-secondary"><i class="fa-solid fa-eraser"></i></a>
            </div>
        </div>
    </form>

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-3 mt-4 ">
                    <div class="card">
                        <div class="card-body text-center">
                            @if (item.ImageURL != null)
                            {
                                <a asp-controller="Home" asp-action="AgentDetails"
                                   asp-route-id="@item.Id" title="VER INFORMACION DEL AGENTE">
                                    <img src="@item.ImageURL" class="card-img-top img-serie-size rounded-circle" />
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Home" asp-action="AgentDetails" asp-route-id="@item.Id" title="VER INFORMACION DEL AGENTE">
                                    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQTnB8SJzsxM_KKbFNf-er2X-WiEdHMHXuz6w&usqp=CAU"
                                         class="card-img-top img-serie-size rounded-circle" />
                                </a>
                            }
                            <h3 class="mt-3 font-weight-bold">@item.FirstName @item.LastName</h3> <!-- Añadido margen superior -->
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="col-6 offset-3">
            <div class="card text-center">
                <div class="card-body">
                    <i class="fa-solid fa-house-circle-check fa-5x text-muted mb-3"></i>
                    <h5 class="card-title">No ha agentes disponisbles en este momento</h5>
                </div>
            </div>
        </div>
    }
</div>

    <style>
    .img-serie-size {
        height: 220px;
        max-width: 80%; 
        transition: transform 0.3s ease-in-out;
    }

    .dancing-script {
        font-family: "Dancing Script", cursive;
        align-items: center;
    }

    .img-serie-size:hover {
        transform: scale(1.1);
    }
</style>