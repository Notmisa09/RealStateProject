@using RealStateApp.Core.Application.ViewModels.Properties
@using RealStateApp.Core.Application.ViewModels.User;
@model List<PropertyAddViewModel>;

@{
    ViewData["Title"] = "";
    SaveUserViewModel user = ViewBag.User;
    List<string> imagesPropertiesRoute = ViewBag.ImagesProperties ?? new List<string>();
}


<div class="container-fluid">
    <div class="row justify-content-end">

        @*IMAGES PROPERTIES *@

        <div class="offset-2 col-6">
            @if (imagesPropertiesRoute != null && imagesPropertiesRoute.Count > 0)
            {
                <div class="text-center mt-3">
                    <section id="carousel-section">
                        <div id="carouselExampleIndicators" class="carousel slide">
                            <div class="carousel-indicators">
                                @for (int i = 0; i < imagesPropertiesRoute.Count; i++)
                                {
                                    <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="@i" class="@((i == 0) ? "active" : "")" aria-current="true" aria-label="Slide @(i+1)"></button>
                                }
                            </div>
                            <div class="carousel-inner">
                                @for (int i = 0; i < imagesPropertiesRoute.Count; i++)
                                {
                                    <div class="carousel-item @((i == 0) ? "active" : "")">
                                        <img src="@imagesPropertiesRoute[i]" class="object-fit-cover w-100" style="height:500px" alt="...">
                                    </div>
                                }
                            </div>
                            <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Previous</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Next</span>
                            </button>
                        </div>
                    </section>
                </div>
            }
            else
            {
                <h3 class="alert alert-danger mt-2 mb-1">
                    Esta propiedad no tiene imágenes
                </h3>
            }
        </div>


        @* CARD USER IMAGES *@

        <div class="card col-md-3 m-3">
            <div class="card-body text-center">
                @if (user.ImageUrl != null)
                {
                        <img src="@user.ImageUrl" class="card-img-top img-serie-size rounded-circle" />
                }
                else
                {
                    <a asp-controller="Home" asp-action="Agents" asp-route-id="" title="VER INFORMACION DEL AGENTE">
                        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQTnB8SJzsxM_KKbFNf-er2X-WiEdHMHXuz6w&usqp=CAU"
                             class="card-img-top img-serie-size rounded-circle" />
                    </a>
                }
                <p class="mt-3 font-weight-bold fs-5">
                    <i class="fas fa-user"></i> @user.FirstName @user.LastName <br>
                    <i class="fas fa-envelope"></i> @user.Email <br>
                    <i class="fas fa-phone"></i> @user.PhoneNumber
                </p>
            </div>
        </div>
    </div>


    @*CARD FOR PROPERTIES *@

    @foreach (var item in Model)
    {

        <div class="col-7 offset-2 mt-3">
            <div class="card">
                <div class="card-body">

                    <div>
                        Codigo: @item.PropertyCode
                        <span class="ms-3">Tipo de propiedad: <span class="badge rounded-pill bg-info">@item.PropertyTypeName</span></span>
                        <span class="ms-3">Tipo de venta: <span class="badge rounded-pill bg-info">@item.SellingTypeName</span></span>
                        <span class="ms-3">
                            Precio: <span style="color:forestgreen; font-weight:bold">
                                RD$ @item.Price
                            </span>
                        </span>
                    </div>

                    <div class="col-10 offset-1">
                        <div class="row g-0">
                            <div class="col-md-4">
                                <i class="fa-solid fa-bed"></i>: @item.BedroomsAmount
                            </div>
                            <div class="col-md-4">
                                <i class="fa-solid fa-sink"></i>: @item.BathroomsAmount
                            </div>
                            <div class="col-md-4">
                                <i class="fa-solid fa-ruler-combined"></i>: @item.Meters
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="mt-3" />

            <div class="row">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <h4>Descripción</h4>
                            <p>@item.Description</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <h4>Mejoras</h4>
                            @foreach (var mejoras in item.ImprovementsName)
                            {
                                <h5><span class="badge bg-warning">@mejoras</span></h5>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>


@* STILOS *@
<style>
    .img-serie-size {
        height: 220px;
        max-width: 80%;
        transition: transform 0.3s ease-in-out;
    }

    .dancing-script {
        font-family: "Dancing Script", cursive;
        align-items: center;
    }

    .img-serie-size:hover {
        transform: scale(1.1);
    }
</style>