@using RealStateApp.Core.Application.ViewModels.Properties
@model IList<PropertyViewModel>

@{
    ViewData["Title"] = "Home Page";
    <script src="https://kit.fontawesome.com/7302c44b99.js" crossorigin="anonymous"></script>
}

<div class="container-fluid">
    <div class="row">
        <div class="card" style="width: 18rem;">
            <img class="card-img-top" src="https://www.ecoprops.co.za/images/slide-1.jpg" alt="Card image cap">
            <div class="card-body">
                <p class="card-text">
                    House for sale in Sabana Perdida, Santo Domingo Norte
                    <br>
                    Code: 161531
                    <br>
                    Price: RD$ 5,000,000
                    <br>
                    <i class="fa-solid fa-bed"></i>: 5
                    <br>
                    <i class="fa-solid fa-sink"></i> : 3
                    <br>
                    Size: 241mt
                </p>
                <a href="#" class="btn btn-primary">Learn more</a>
            </div>
        </div>

        <div class="card ms-4" style="width: 18rem;">
            <img src="https://www.ecoprops.co.za/images/slide-1.jpg" class=" imgproduct card-img-top img-fluid" alt="Producto">
            <div class="card-body">
                <p class="card-text">
                    House for sale in Sabana Perdida, Santo Domingo Norte
                    <br>
                    Code: 161531
                    <br>
                    Price: RD$ 5,000,000
                    <br>
                    <i class="fa-solid fa-bed"></i>: 5
                    <br>
                    <i class="fa-solid fa-sink"></i> : 3
                    <br>
                    Size: 241mt
                </p>
                <a href="#" class="btn btn-dark">Learn more</a>
            </div>
        </div>
    </div>
</div>

<style>
    /* SECCION PARA LOS CARDVIEW */
    .card {
        border-radius: 20px;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
    }

    .cardproduct:hover {
        transform: translateY(-5px);
        box-shadow: 0px 6px 12px rgba(0, 0, 0, 0.2);
    }

    .body {
        font-family: "Josefin Sans", sans-serif;
    }

    .card img {
        width: 100%;
        display: block;
    }

    .price-amount {
        color: #2ecc71;
    }

</style>

