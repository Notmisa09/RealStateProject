@using RealStateApp.Core.Application.ViewModels.Properties
@model IList<PropertyViewModel>

@{
    ViewData["Title"] = "Home Page";
}

<div class="col-md-3">
    <div class=" cardproduct card h-100">
        <img src="" class=" imgproduct card-img-top img-fluid" alt="Producto">
        <div class="card-body">
            <h5 class="card-title">@item.Name</h5>
            <p class="card-text">
                @item.Description
            </p>
        </div>
        <div>
            <div class="d-flex justify-content-between align-items-center">
                <div class="btn-group m-3">
                    <a asp-controller="Product" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger m-2"><i class="fa-solid fa-trash-can"></i></a>
                    <a asp-controller="Product" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning m-2"><i class="fa-solid fa-pen"></i></a>
                </div>
                <small class="price-amount text-body-secondary fw-bold fs-5 m-2">$</small>
            </div>
        </div>
    </div>
</div>