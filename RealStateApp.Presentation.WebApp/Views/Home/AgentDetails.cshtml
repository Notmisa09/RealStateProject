@using RealStateApp.Core.Application.ViewModels.Properties
@using RealStateApp.Core.Application.ViewModels.User;
@model List<PropertyAddViewModel>;

@{
    ViewData["Title"] = "";
    SaveUserViewModel user = ViewBag.User;
}

<head>
    <script src="https://kit.fontawesome.com/7302c44b99.js" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/5.1.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://kit.fontawesome.com/7302c44b99.js" crossorigin="anonymous">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400..700&display=swap" rel="stylesheet">
</head>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-9">

            <h1 class="dancing-script text-center m-3">Propiedades de @user.FirstName @user.LastName</h1>

            @if (Model.Any())
            {
                <div class="row">
                    @foreach (var item in Model)
                    {
                        <div class="col-md-4">
                            <div class="card ms-4 p-0 mt-3" style="width: 18rem;">
                                <div class="image-container">
                                    <img src="@item.FrontImage" class="card-img-top img-fluid" alt="Property Image">
                                </div>
                                <div class="card-body">
                                    <p class="card-text fs-4">
                                        <div>
                                            <div>
                                                Tipo de propiedad: <span class="badge rounded-pill bg-info mt-2">@item.PropertyTypeName</span>
                                            </div>
                                            <div>
                                                Tipo de venta: <span class="badge rounded-pill bg-info">@item.SellingTypeName</span>
                                            </div>
                                        </div>

                                        <div class="mb-1">
                                            Codigo: @item.PropertyCode
                                        </div>

                                        <div class="mb-1">
                                            Precio: <span style="color:forestgreen; font-weight:bold">
                                                RD$ @item.Price
                                            </span>
                                        </div>

                                        <div class="mb-1">
                                            <i class="fa-solid fa-location-dot"></i> @item.Location
                                        </div>
                                        <div class="col-10 offset-1">
                                            <div class="row g-0">
                                                <div class="col-md-4">
                                                    <i class="fa-solid fa-bed"></i>: @item.BedroomsAmount
                                                </div>
                                                <div class="col-md-4">
                                                    <i class="fa-solid fa-sink"></i>: @item.BathroomsAmount
                                                </div>
                                                <div class="col-md-4">
                                                    <i class="fa-solid fa-ruler-combined"></i>: @item.Meters
                                                </div>
                                            </div>
                                        </div>
                                    </p>
                                    <a asp-route-Id="@item.Id" asp-action="Details" asp-controller="Home" class="btn btn-dark">Details</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="col-6 offset-3 mt-4">
                    <div class="card text-center">
                        <div class="card-body">
                            <i class="fa-solid fa-house-circle-check fa-5x text-muted mb-3"></i>
                            <h5 class="card-title">Este agente no tienes propiedades registradas </h5>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="col-md-3">
            <div class="card mt-3">
                <div class="card-body text-center">
                    @if (user.ImageUrl != null)
                    {
                        <a asp-controller="Home" asp-action="Agents"
                           asp-route-id="@user.Id" title="VER INFORMACION DEL AGENTE">
                            <img src="@user.ImageUrl" class="card-img-top img-serie-size rounded-circle" />
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Home" asp-action="Agents" asp-route-id="" title="VER INFORMACION DEL AGENTE">
                            <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQTnB8SJzsxM_KKbFNf-er2X-WiEdHMHXuz6w&usqp=CAU"
                                 class="card-img-top img-serie-size rounded-circle" />
                        </a>
                    }
                    <p class="mt-3 font-weight-bold fs-5">
                        <i class="fas fa-user"></i> @user.FirstName @user.LastName <br>
                        <i class="fas fa-envelope"></i> @user.Email <br>
                        <i class="fas fa-phone"></i> @user.PhoneNumber
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .img-serie-size {
        height: 220px;
        max-width: 80%;
        transition: transform 0.3s ease-in-out;
    }

    .dancing-script {
        font-family: "Dancing Script", cursive;
        align-items: center;
    }

    .img-serie-size:hover {
        transform: scale(1.1);
    }
</style>
