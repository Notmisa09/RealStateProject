@using Microsoft.AspNetCore.Mvc.TagHelpers
@using RealStateApp.Core.Application.Dto.Acccount.AuthenticateDtos
@using RealStateApp.Core.Application.Helpers;
@using RealStateApp.Core.Application.Enum;
@inject IHttpContextAccessor httpContex;

@{
    var user = httpContex.HttpContext.Session.Get<AuthenticationResponse>("user");
    var admin = RolesEnum.Admin.ToString();
    var client = RolesEnum.Client.ToString();
    var agent = RolesEnum.Agent.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RealStateApp.Presentation.WebApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/table.css" />
    <link rel="stylesheet" href="~/RealStateApp.Presentation.WebApp.styles.css" asp-append-version="true" />
    <script src="https://kit.fontawesome.com/7302c44b99.js" crossorigin="anonymous"></script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-0">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="" asp-action=""><i class="fa-solid fa-house-circle-check"></i></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        @if (user != null)
                        {
                            if (user.Roles.Contains(admin))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Admin" asp-action="DashBoard">DashBoard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Admin" asp-action="AgentList">Lista de agentes</a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        Mantenimientos
                                    </a>
                                    <dv class="dropdown-menu" aria-labelledby="navbarDropdown">
                                        <a class="nav-link text-dark" asp-area="" asp-controller="SellingType" asp-action="Index">Mant.ventas</a>
                                        <a class="nav-link text-dark" asp-area="" asp-controller="PropertyType" asp-action="Index">Mant.propiedades</a>
                                        <a class="nav-link text-dark" asp-area="" asp-controller="Admin" asp-action="AdminList">Mant.Admin</a>
                                        <a class="nav-link text-dark" asp-area="" asp-controller="Improvements" asp-action="Index">Mant.Mejoras</a>
                                        <a class="nav-link text-dark" asp-area="" asp-controller="Admin" asp-action="DevList">Mant.dev</a>
                                    </dv>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="User" asp-action="LogOut">Log out</a>
                                </li>
                            }
                        }

                        @if (user != null)
                        {
                            if (user.Roles.Contains(client))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Client" asp-action="Index">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Client" asp-action="MyProperties">Mis propiedades!</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="User" asp-action="LogOut">Log out</a>
                                </li>
                            }
                        }

                        @if (user != null)
                        {
                            if (user.Roles.Contains(agent))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Agent" asp-action="Index">Mis propiedades!</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Agent" asp-action="Profile">Mi perfil</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Agent" asp-action="PropertyList">Mant. de propiedades</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="User" asp-action="LogOut">Log out</a>
                                </li>
                            }
                        }


                        @if (user == null)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Agents">Agentes</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="User" asp-action="Index">Inicia Sesion</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="User" asp-action="Register">Unete a la app!</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container p-0">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="py-3 mt-auto">
        <div class="container d-flex flex-wrap justify-content-between align-items-center">
            <p class="col-md-4 mb-0 text-body-secondary">Felix Misael Mora</p>

            <a href="#"
               class="col-md-4 d-flex align-items-center justify-content-center mb-3 mb-md-0 me-md-auto text-decoration-none">
                <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 41 41" fill="none">
                    <g clip-path="url(#clip0_48_159)">
                        <mask id="mask0_48_159" style="mask-type: luminance" maskUnits="userSpaceOnUse" x="0" y="0"
                              width="41" height="41">
                            <path d="M0 0H41V41H0V0Z" fill="white" />
                        </mask>
                        <i class="fa-solid fa-house-circle-check fa-xl" style="color: #131415;"></i>
                    </g>
                    <defs>
                        <clipPath id="clip0_48_159">
                            <rect width="41" height="41" fill="white" />
                        </clipPath>
                    </defs>
                </svg>
            </a>
            @if (user != null)
            {
                if (user.Roles.Contains(client))
                {
                    <ul class="nav col-md-4 justify-content-end">
                        <li class="nav-item">
                            <a asp-controller="Client" asp-action="Index" class="nav-link px-2 text-body-secondary">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Client" asp-action="MyProperties">Mis propiedades!</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Client" asp-action="LogOut">Log out</a>
                        </li>
                    </ul>
                }

                if (user.Roles.Contains(agent))
                {
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Agent" asp-action="Index">Mis propiedades!</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Agent" asp-action="Profile">Mi perfil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Agent" asp-action="PropertyList">Mant. de propiedades</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="User" asp-action="LogOut">Log out</a>
                    </li>
                }

                @if (user.Roles.Contains(admin))
                {
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Admin" asp-action="DashBoard">DashBoard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Admin" asp-action="AgentList">Lista de agentes</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="User" asp-action="LogOut">Log out</a>
                    </li>
                }
            }


            @if (user == null)
            {
                <ul class="nav col-md-4 justify-content-end">
                    <li class="nav-item">
                        <a asp-controller="Home" asp-action="Index" class="nav-link px-2 text-body-secondary">Home</a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Home" asp-action="Agents"
                           class="nav-link px-2 text-body-secondary">Agents</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-2 text-body-secondary" asp-area="" asp-controller="User" asp-action="Index">Inicia Sesion</a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="User" asp-action="Register" class="nav-link px-2 text-body-secondary">Unete a la app!</a>
                    </li>
                </ul>
            }
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

