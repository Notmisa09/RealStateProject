@using RealStateApp.Core.Application.ViewModels.PropertyType;
@model PropertyTypeAddViewModel;

@{
    ViewData["Title"] = "Register Property type";
    bool editMode = Model != null && Model.Id != 0;
}

<div class="container-fluid" >
    <div class="col-4 offset-4" >
        <div class="card">
            <div class="card-header">
                <strong>@(editMode ? $"Edit your pruducer {Model.PropertyName}" : "Add a new User")</strong>

            </div>
            <div class="card-body">
                <form method="post" asp-controller="PropertyType" asp-action=@(editMode ? "Edit" : "Save")>
                    <div class="mb-3">
                        <label asp-for="PropertyName" class="form-label text-dark">Nombre: </label>
                        <input asp-for="PropertyName" class="form-control" style="background-color: white; color: black;" />
                        <span asp-validation-for="PropertyName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label text-dark">Apellido: </label>
                        <input asp-for="Description" class="form-control" style="background-color: white; color: black;" />
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <a asp-controller="PropertyType" asp-action="Index" class="btn btn-primary">@editMode ? "Edit" : "Create"</a>
                    <button type="submit" class="btn btn-warning">Go back</button>
                </form>
            </div>
        </div>
    </div>
</div>

