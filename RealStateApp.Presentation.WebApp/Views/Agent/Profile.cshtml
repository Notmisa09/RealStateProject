@using RealStateApp.Core.Application.ViewModels.User;
@using RealStateApp.Core.Application.Enum;
@model SaveUserViewModel;

@{
    ViewData["Title"] = "Register";
}

<div class="container-fluid">

    <div class="row">
        <div class="col-6 offset-3">
            <div class="card" style="background-color: white;">
                <div class="card-header  text-center bg-black">
                    <h4 class="text-light">Edita tu perfil</h4>
                </div>
                <div class="card-body">

                    <form method="post" enctype="multipart/form-data" asp-controller="Agent" asp-action="Profile">

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label font-weight-bold text-dark">Nombre: </label>
                                <input asp-for="FirstName" class="form-control" style="background-color: white; color: black;" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label font-weight-bold text-dark">Apellido: </label>
                                <input asp-for="LastName" class="form-control" style="background-color: white; color: black;" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label text-dark">Nombre de usuario: </label>
                            <input asp-for="UserName" class="form-control" style="background-color: white; color: black;" />
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label asp-for="PhoneNumber" class="form-label text-dark">Telefono: </label>
                                <input asp-for="PhoneNumber" class="form-control" style="background-color: white; color: black;" />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label text-dark">Correo: </label>
                                <input asp-for="Email" class="form-control" style="background-color: white; color: black;" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label text-dark">Contraseña: </label>
                            <input asp-for="Password" type="password" class="form-control" style="background-color: white; color: black;" />
                            <label asp-for="Password" class="form-label text-secondary">En caso de querer actualizar la contraseña llenar estos campos</label>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label text-dark">Confirmar contraseña: </label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" style="background-color: white; color: black;" />
                            <label asp-for="Password" class="form-label text-secondary">Confirmar la contraseña en caso de actualizar</label>
                        </div>

                        <input asp-for="Id" type="hidden" class="form-control" style="background-color: white; color: black;" />

                        <input asp-for="Identification" type="hidden" class="form-control" style="background-color: white; color: black;" />

                        <button type="submit" class="btn btn-primary">Registrarse</button>
                        <a asp-controller="Agent" asp-action="Index" class="btn btn-warning">Volver atras</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        background-color: white;
        margin: auto;
        margin-top: 5%;
        padding: 20px;
        border-radius: 15px;
        box-shadow: 0 0 20px 0 rgba(0, 0, 0, 0.1);
    }

    .card-header {
        border-bottom: none;
        margin-bottom: 20px;
        padding-bottom: 0;
    }

    .form-label {
        font-weight: bold;
    }

    .form-control {
        border-radius: 10px;
        border: 1px solid #ced4da;
    }

    .btn-primary {
        border-radius: 10px;
        background-color: #6c63ff;
        border: none;
    }

    .btn-warning {
        border-radius: 10px;
        background-color: #ffb74d;
        border: none;
    }

    .text-danger {
        color: red;
    }
</style>
