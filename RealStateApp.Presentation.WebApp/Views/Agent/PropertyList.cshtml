@using RealStateApp.Core.Application.ViewModels.Improvements
@using RealStateApp.Core.Application.ViewModels.Properties
@using RealStateApp.Core.Application.ViewModels.PropertyType
@using RealStateApp.Core.Application.ViewModels.SellingTypes
@model IList<PropertyAddViewModel>

@{
    ViewData["Title"] = "Home Page";
    <script src="https://kit.fontawesome.com/7302c44b99.js" crossorigin="anonymous"></script>
    <link href="./css/homesite.css" rel="stylesheet">

    List<PropertyTypeViewModel> proptypelist = ViewBag.PropertyTypeList;
    List<SellingTypeVeiwModel> sellingtypelist = ViewBag.SellingTypeList;
    List<ImprovemetnsViewModel> improvementslist = ViewBag.Improvements;

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"></script>
}



@if (proptypelist.Count() == 0 || sellingtypelist.Count() == 0 || improvementslist.Count() == 0)
{
    <div class="col-6 offset-3 mt-4">
        <div class="card text-center">
            <div class="card-body">
                <i class="fa-solid fa-house-circle-check fa-5x text-muted mb-3"></i>
                <h5 class="card-title">No existen tipo de venta , mejoras o tipo de propiedad</h5>
            </div>
        </div>
    </div>
}

@if (Model.Count() == 0)
{
    <div class="col-6 offset-3 mt-4">
        <div class="card text-center">
            <div class="card-body">
                <i class="fa-solid fa-house-circle-check fa-5x text-muted mb-3"></i>
                <h5 class="card-title">No tiene propiedades creadas aun</h5>
                <a asp-controller="Agent" asp-action="AddProperties" class="btn btn-primary mt-4">Registra una nueva propiedad</a>
            </div>
        </div>
    </div>
}
else
{
    <a asp-controller="Agent" asp-action="AddProperties" class="btn btn-primary m-3">Registra una nueva propiedad</a>

    <section id="Property-section" class="mt-5">
        <div class="container-fluid mt-5">
            <div class="card">
                <div class="card-body">
                    <div class="row">

                        @foreach (var item in Model)
                        {
                            <div class="card ms-4 p-0 mt-3 " style="width: 18rem;">
                                <div class="image-container">
                                    <img src="@item.FrontImage" class="card-img-top img-fluid" alt="Property Image">
                                </div>
                                <div class="card-body">
                                    <p class="card-text fs-4">
                                        <div>
                                            <div>
                                                Tipo de propiedad: <span class="badge rounded-pill bg-info mt-2">@item.PropertyTypeName</span>
                                            </div>
                                            <div>
                                                Tipo de venta: <span class="badge rounded-pill bg-info">@item.SellingTypeName</span>
                                            </div>
                                        </div>
                                        <div class="mb-1">
                                            Codigo: @item.PropertyCode
                                        </div>

                                        <div class="mb-1">
                                            Precio: <span style="color:forestgreen; font-weight:bold">
                                                RD$ @item.Price
                                            </span>
                                        </div>

                                        <div class="mb-1">
                                            <i class="fa-solid fa-location-dot"></i> @item.Location
                                        </div>
                                        <div class="col-10 offset-1">
                                            <div class="row g-0">
                                                <div class="col-md-4">
                                                    <i class="fa-solid fa-bed"></i>: @item.BedroomsAmount
                                                </div>
                                                <div class="col-md-4">
                                                    <i class="fa-solid fa-sink"></i>: @item.BathroomsAmount
                                                </div>
                                                <div class="col-md-4">
                                                    <i class="fa-solid fa-ruler-combined"></i>: @item.Meters
                                                </div>
                                            </div>
                                        </div>
                                    </p>
                                    <a asp-route-Id="@item.Id" asp-controller="Property" asp-action="Remove" class="btn btn-outline-danger"><i class="fa-solid fa-trash-can"></i></a>
                                    <a asp-route-Id="@item.Id" asp-controller="Agent" asp-action="Edit" class="btn btn-outline-warning"><i class="fa-solid fa-pencil"></i></a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
}


<style>

    .image-container {
        height: 200px;
        overflow: hidden;
    }

        .image-container img {
            object-fit: cover;
            height: 100%;
            width: 100%;
        }
</style>

