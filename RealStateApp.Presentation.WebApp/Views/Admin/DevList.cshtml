@using RealStateApp.Core.Application.ViewModels.User;
@model List<UserViewModel>;

@{
    ViewData["Title"] = "Dev.List";
}

<head>
    <link rel="stylesheet" href="~/css/table.css" />
    <script src="https://kit.fontawesome.com/7302c44b99.js" crossorigin="anonymous"></script>
</head>

<div class="container-fluid">
    <a asp-controller="Dev" asp-action="RegisterDev" class="btn btn-primary">Register</a>
    <div class="card mt-2">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Name</th>
                            <th>Apellido</th>
                            <th>Correo</th>
                            <th>Activar Usuario</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dev in Model)
                        {
                            <tr>
                                @if (dev.ImageURL == null)
                                {
                                    <td>
                                        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQTnB8SJzsxM_KKbFNf-er2X-WiEdHMHXuz6w&usqp=CAU"
                                             class="rounded-circle" style="width: 35px; height: 35px;" />
                                    </td>
                                }
                                else
                                {
                                    <td>
                                        <img src="@dev.ImageURL" class="rounded-circle" style="width: 35px; height: 35px;" />
                                    </td>
                                }
                                <td>@dev.FirstName</td>
                                <td>@dev.LastName</td>
                                <td>@dev.Email</td>
                                @if (dev.IsActive == true)
                                {
                                    <td><span class="badge bg-label-success me-1">Active</span></td>
                                }
                                @if (dev.IsActive == false)
                                {
                                    <td><span class="badge bg-label-danger me-1">Inactive</span></td>
                                }
                                <td>
                                    <div class="dropdown">
                                        <button class="btn p-0 dropdown-toggle hide-arrow" type="button" id="burgerDropdownMenuButton" data-bs-toggle="dropdown">
                                            <i class="fas fa-bars" style="font-size: 20px;"></i>
                                        </button>
                                        <div class="dropdown-menu dropdown-menu-end" aria-labelledby="burgerDropdownMenuButton">
                                            @if (dev.IsActive == false)
                                            {
                                                <a class="dropdown-item Dropdownburger" data-user-id="@dev.Id" data-action="ChangeStatus">
                                                    <i class="fas fa-toggle-on" style="font-size: 20px; margin-right: 7px;"></i> Active
                                                </a>
                                            }
                                            @if (dev.IsActive == true)
                                            {
                                                <a class="dropdown-item Dropdownburger" data-user-id="@dev.Id" data-action="ChangeStatus">
                                                    <i class="fas fa-toggle-off" style="font-size: 20px; margin-right: 7px;"></i> Inactive
                                                </a>
                                            }
                                            <a class="dropdown-item" asp-route-Id="@dev.Id" asp-controller="Dev" asp-action="EditDev">
                                                <i class="fa-solid fa-user-minus" style="font-size: 20px; margin-right: 7px;"></i> Editar
                                            </a>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>


    <!-- Modal de Confirmación -->
    <div class="modal fade" id="confirmationModal" tabindex="-1" aria-labelledby="confirmationModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmationModalLabel">Confirmación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    ¿Estás seguro de que deseas realizar esta acción?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="confirmActionBtn">Confirmar</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll('.Dropdownburger').forEach(item => {
                item.addEventListener('click', function (event) {
                    event.preventDefault();
                    const userId = this.getAttribute('data-user-id');
                    const action = this.getAttribute('data-action');

                    // Mostrar el modal de confirmación
                    $('#confirmationModal').modal('show');

                    // Configurar el botón de confirmación para que redireccione con el ID del usuario y la acción
                    document.getElementById('confirmActionBtn').addEventListener('click', function () {
                        window.location.href = `@Url.Action("ChangeStatus", "Dev")?Id=${userId}`;
                        $('#confirmationModal').modal('hide');
                    });
                });
            });
        });
    </script>
