@using RealStateApp.Core.Application.ViewModels.Properties;
@model List<PropertyAddViewModel>;

@{
    ViewData["Title"] = "Properties Agent";
}

<section id="Property-section" class="mt-5">
    <div class="container-fluid mt-5">
        <div class="row">
            <div class="col-md-6 offset-md-3">
                <div class="card mb-3">
                    <div class="card-body">
                        <h3 class="card-title text-center">¿Estás seguro que quieres eliminar esta propiedad?</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4">
                    <div class="card mb-4">
                        <div class="image-container">
                            <img src="@item.FrontImage" class="card-img-top" alt="Property Image">
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">@item.PropertyTypeName</h5>
                            <p class="card-text">
                                <strong>Código:</strong> @item.PropertyCode <br>
                                <strong>Tipo de venta:</strong> @item.SellingTypeName <br>
                                <strong>Precio:</strong> RD$ @item.Price <br>
                                <strong>Ubicación:</strong> @item.Location <br>
                                <strong>Habitaciones:</strong> @item.BedroomsAmount <br>
                                <strong>Baños:</strong> @item.BathroomsAmount <br>
                                <strong>Metros:</strong> @item.Meters
                            </p>
                            <form method="post" asp-controller="Property" asp-action="RemoveTrue">
                                <input type="hidden" asp-for="@item.Id" value="@item.Id" />
                                <button type="submit" class="btn btn-danger float-end">Eliminar</button>
                            </form>
                            <a asp-route-Id="@item.Id" asp-controller="Agent" asp-action="AddProperties" class="btn btn-warning float-start">Volver</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<style>
    .image-container {
        height: 200px;
        overflow: hidden;
    }

        .image-container img {
            object-fit: cover;
            height: 100%;
            width: 100%;
        }
</style>
